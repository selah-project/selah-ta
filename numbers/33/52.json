{"tier":"glm-5.2","verse":52,"ref":"numbers 33:52","book":"numbers","lang":"ta","chapter":33,"translation":"நீங்கள் ⟨את⟩ தேசத்தின் குடிகள் அனைவரையும் உங்களுக்கு முன்பிருந்து விரட்டியகற்றுவீர்கள்; அவர்களுடைய ⟨את⟩ சிற்பங்கள் அனைத்தையும் அழித்து, அவர்களுடைய ⟨את⟩ உருக்கிவார்த்த உருவங்கள் அனைத்தையும் அழிப்பீர்கள், அவர்களுடைய ⟨את⟩ மேட்டுச் சன்னிதிகள் அனைத்தையும் அழித்து நொறுக்குவீர்கள்.","tokens":[{"surface":"והורשתם","gloss":"விரட்டியகற்றுவீர்கள்"},{"surface":"את","gloss":"⟨את⟩","marks":"குடிகள் அனைவரையும்"},{"surface":"כל","gloss":"அனைத்தையும் \/ அனைவரையும்"},{"surface":"ישבי","gloss":"குடிகள்"},{"surface":"הארץ","gloss":"தேசத்தின்"},{"surface":"מפניכם","gloss":"உங்களுக்கு முன்பிருந்து"},{"surface":"ואבדתם","gloss":"அழித்து"},{"surface":"את","gloss":"⟨את⟩","marks":"சிற்பங்கள் அனைத்தையும்"},{"surface":"כל","gloss":"அனைத்தையும்"},{"surface":"משכיתם","gloss":"சிற்பங்கள்"},{"surface":"ואת","gloss":"⟨את⟩","marks":"உருவங்கள் அனைத்தையும்"},{"surface":"כל","gloss":"அனைத்தையும்"},{"surface":"צלמי","gloss":"உருவங்கள்"},{"surface":"מסכתם","gloss":"உருக்கிவார்த்த"},{"surface":"תאבדו","gloss":"அழிப்பீர்கள்"},{"surface":"ואת","gloss":"⟨את⟩","marks":"சன்னிதிகள் அனைத்தையும்"},{"surface":"כל","gloss":"அனைத்தையும்"},{"surface":"במתם","gloss":"மேட்டுச் சன்னிதிகள்"},{"surface":"תשמידו","gloss":"அழித்து நொறுக்குவீர்கள்"}],"timestamp":"2026-08-19T22:14:59.698320923Z","model":"glm-5.3"}